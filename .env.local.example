# 展示模式：默认首页进入静态方案；语音页照片仅在浏览器内预览。
LOCAL_DEMO_PREVIEW=1
# 仅限本机演示身份；不提供真实登录、数据库或模型能力。
AUTH_BYPASS_ENABLED=1
# 空数据库不可用；展示模式先跳过自动建表。
RUNTIME_SCHEMA_SETUP=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# 完整业务模式需要自行配置 PostgreSQL 和缺失的业务表。
POSTGRES_URL=
POSTGRES_POOL_MAX=3
POSTGRES_CONNECTION_TIMEOUT_MS=20000

# 图片对象存储：仅在需要真实上传/保存时配置。
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# 空间理解、推荐重排和效果图。
QWEN_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# 实时语音；模型名称/账号权限需自行核实。
OPENAI_API_KEY=
# 价格工具默认关闭。只有接入可信真实价格后才启用。
VOICE_PRICE_TOOLS_ENABLED=0
# 可选：设为 1 将语音模型强制切为 mini。
VOICE_FORCE_MINI=0

# 真实登录：公开变量仅包含 URL 和 publishable/anon key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_ADMIN_EMAILS=
